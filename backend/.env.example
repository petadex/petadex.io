DB_HOST=
DB_PORT=5432
DB_NAME=petadex
DB_USER=
DB_PASS=

# AWS Credentials (Add these!)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1  # (Change to your actual region if different)

# change this if you run the backend on a different port than your Gatsby site
PORT=3001

# Predicted structure files (Alex / ESMFold2):
#   {STRUCTURE_S3_BASE}/{STRUCTURE_S3_LANE}/structures/orf{id}.cif
#   {STRUCTURE_S3_BASE}/{STRUCTURE_S3_LANE}/metrics/orf{id}.json
# Demo (public today): esmfold2-centroids/test2
# Production (when Alex opens it): esmfold2-centroids/60pid
# STRUCTURE_S3_BASE=https://petadex-protein-structures.s3.amazonaws.com
# STRUCTURE_S3_LANE=esmfold2-centroids/test2
# Optional MSA experimental lane (same layout; was “finetune”). Leave empty to hide Base/MSA toggle.
# STRUCTURE_S3_MSA_LANE=
# STRUCTURE_S3_FINETUNE_LANE=   # legacy alias for STRUCTURE_S3_MSA_LANE
# BacDive / BacDrive biosample means (Denis CSV #3).
# Default URL is private today (403) — drop the CSV locally or set:
# BACDIVE_MEANS_PATH=./data/biosample_bacdive_means.csv
# BACDIVE_MEANS_URL=https://petabite.s3.us-east-1.amazonaws.com/automated-metadata/bacdive_data_analysis/biosample_bacdive_means.csv

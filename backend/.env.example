DB_HOST=
DB_PORT=5432
DB_NAME=petadex
DB_USER=
DB_PASS=

# AWS Credentials (Add these!)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1  # (Change to your actual region if different)

# change this if you run the backend on a different port than your Gatsby site
PORT=3001

# Predicted structure files (Alex / ESMFold2). Defaults match
# s3://petadex-protein-structures with {orf_id}.cif / {orf_id}.npy keys.
# Finetune parallels (assumed): esmatlas-finetune/, esmfold2-centroids/90pid-finetune/
# STRUCTURE_S3_BASE=https://petadex-protein-structures.s3.amazonaws.com
# STRUCTURE_ARRAY_EXT=.npy


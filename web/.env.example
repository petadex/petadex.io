# PETadex web (Next.js) — environment
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Every value here is NEXT_PUBLIC_* because the browser needs the API origin for
# client-side polling (sequence search) and for the direct-from-S3 atlas fetch.
# There are no secrets: the database is read-only and public, and there is no auth.

# --- Required -----------------------------------------------------------------

# Base URL of the Express API, including the /api prefix.
#   local backend : http://localhost:3001/api
#   production    : https://8ww706wo68.execute-api.us-east-1.amazonaws.com/api
#
# NOTE: the plan targets https://api.petadex.net/api, but Phase 0 flags that
# hostname as unresolved (no A/CNAME found; a build run resolved it to an IP that
# timed out). Use the API Gateway URL until that is settled.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Absolute origin this deployment is served from. Used for canonical URLs and
# Open Graph tags (metadataBase). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional -----------------------------------------------------------------

# Sequence-search API, if it is ever split off the main Lambda.
# Falls back to NEXT_PUBLIC_API_URL when unset.
# NEXT_PUBLIC_SEARCH_API_URL=

# Gzipped family-atlas UMAP payload (~20 MB, exceeds Lambda's 6 MB response cap,
# so it is fetched straight from S3). Falls back to the S3 object when unset.
# NEXT_PUBLIC_ATLAS_DATA_URL=https://petadex.s3.amazonaws.com/atlas/umap.json.gz

# Timeout in ms for a single API request. Server-side render and build-time
# fetches both use it. Express itself caps out around 28s against a 29s Lambda
# timeout, so going much above 30000 buys nothing.
# NEXT_PUBLIC_API_TIMEOUT_MS=30000
